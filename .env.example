# === ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO ===
# Renombra este archivo a .env y completa los valores con tus propias credenciales

# Ruta donde se guardarán las películas descargadas
DOWNLOAD_DIR="D:\pelis cristianas"

# Límite de películas a scrapearlas por defecto
MAX_MOVIES_TO_DOWNLOAD=20

# Obtén tu API Key gratuita en https://www.themoviedb.org/settings/api
TMDB_API_KEY="TU_API_KEY_AQUI"

# Obtén tu API Key en https://www.omdbapi.com/ (Opcional)
OMDB_API_KEY="TU_API_KEY_AQUI"

# ==========================================
# NOTIFICACIONES PUSH - TELEGRAM (NUEVO)
# ==========================================
# 1. Crea un bot en Telegram hablando con @BotFather y pega aquí el Token
TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"

# 2. Obtén tu ID personal en Telegram hablando con @userinfobot
TELEGRAM_CHAT_ID="123456789"
